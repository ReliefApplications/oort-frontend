{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "back-office",
  "prefix": "app",
  "projectType": "application",
  "sourceRoot": "apps/back-office/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "dependsOn": ["generate-build-version"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/back-office",
        "index": "apps/back-office/src/index.html",
        "main": "apps/back-office/src/main.ts",
        "polyfills": ["apps/back-office/src/polyfills.ts"],
        "tsConfig": "apps/back-office/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "libs/shared/src/i18n/",
            "output": "/assets/i18n/"
          },
          {
            "glob": "**/*",
            "input": "assets/",
            "output": "/assets/"
          },
          "apps/back-office/src/favicon.ico",
          "apps/back-office/src/web.config",
          {
            "glob": "**/*",
            "input": "node_modules/tinymce",
            "output": "/tinymce/"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/src/i18n/tinymce/",
            "output": "/tinymce/langs"
          },
          {
            "glob": "**/*",
            "input": "node_modules/leaflet/dist/images/",
            "output": "/"
          },
          {
            "glob": "**/*",
            "input": "node_modules/monaco-editor",
            "output": "/assets/monaco/"
          }
        ],
        "styles": [
          "apps/back-office/src/styles.scss",
          "libs/shared/src/lib/style/styles.scss",
          "libs/styles/src/lib/tailwind/tailwind.scss",
          "libs/styles/src/lib/kendo/theme.scss",
          "libs/styles/src/lib/shared/shared.scss",
          "node_modules/survey-core/survey-core.min.css",
          "node_modules/survey-creator-core/survey-creator-core.min.css",
          "node_modules/leaflet/dist/leaflet.css",
          "node_modules/leaflet.markercluster/dist/MarkerCluster.css",
          "node_modules/leaflet.markercluster/dist/MarkerCluster.Default.css",
          "node_modules/leaflet-fullscreen/dist/leaflet.fullscreen.css",
          "node_modules/leaflet-measure/dist/leaflet-measure.css",
          "node_modules/esri-leaflet-geocoder/dist/esri-leaflet-geocoder.css",
          "node_modules/@geoman-io/leaflet-geoman-free/dist/leaflet-geoman.css"
        ],
        "scripts": [
          "node_modules/tinymce/tinymce.min.js",
          "node_modules/tinymce/themes/silver/theme.min.js",
          "node_modules/shpjs/dist/shp.min.js"
        ],
        "allowedCommonJsDependencies": [
          "minimatch",
          "hammerjs",
          "subscriptions-transport-ws",
          "zen-observable",
          "lodash",
          "cronstrue",
          "cron-parser",
          "cron-validator",
          "localforage",
          "survey-core",
          "survey-creator-core",
          "survey-angular-ui",
          "fast-sha256",
          "leaflet",
          "esri-leaflet-geocoder",
          "esri-leaflet-vector",
          "leaflet.markercluster",
          "color",
          "esri-leaflet-heatmap",
          "esri-leaflet-renderers",
          "jsonpath",
          "buffer",
          "to-json-schema"
        ]
      },
      "configurations": {
        "mab-prod": {
          "fileReplacements": [
            {
              "replace": "apps/back-office/src/environments/environment.ts",
              "with": "apps/back-office/src/environments/environment.mab.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "12mb",
              "maximumError": "15mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "14kb"
            }
          ],
          "baseHref": "/admin/",
          "outputHashing": "all",
          "stylePreprocessorOptions": {
            "includePaths": ["libs/styles/src/lib/themes/unesco-mab"]
          }
        },
        "mab-prod-local": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "stylePreprocessorOptions": {
            "includePaths": ["libs/styles/src/lib/themes/unesco-mab"]
          },
          "fileReplacements": [
            {
              "replace": "apps/back-office/src/environments/environment.ts",
              "with": "apps/back-office/src/environments/environment.mab.prod.local.ts"
            }
          ]
        },
        "mab-dev": {
          "fileReplacements": [
            {
              "replace": "apps/back-office/src/environments/environment.ts",
              "with": "apps/back-office/src/environments/environment.mab.dev.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "12mb",
              "maximumError": "15mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "14kb"
            }
          ],
          "baseHref": "/admin/",
          "outputHashing": "all",
          "stylePreprocessorOptions": {
            "includePaths": ["libs/styles/src/lib/themes/unesco-mab"]
          }
        },
        "mab-dev-local": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "stylePreprocessorOptions": {
            "includePaths": ["libs/styles/src/lib/themes/unesco-mab"]
          },
          "fileReplacements": [
            {
              "replace": "apps/back-office/src/environments/environment.ts",
              "with": "apps/back-office/src/environments/environment.mab.dev.local.ts"
            }
          ]
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "stylePreprocessorOptions": {
            "includePaths": ["libs/styles/src/lib/themes/unesco-mab"]
          }
        }
      },
      "defaultConfiguration": "mab-prod"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "dependsOn": ["generate-build-version"],
      "configurations": {
        "mab-prod": {
          "browserTarget": "back-office:build:mab-prod"
        },
        "mab-prod-local": {
          "browserTarget": "back-office:build:mab-prod-local"
        },
        "mab-dev": {
          "browserTarget": "back-office:build:mab-dev"
        },
        "mab-dev-local": {
          "browserTarget": "back-office:build:mab-dev-local"
        },
        "development": {
          "browserTarget": "back-office:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "browserTarget": "back-office:build"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "apps/back-office/**/*.ts",
          "apps/back-office/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/back-office/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "storybook": {
      "executor": "@storybook/angular:start-storybook",
      "options": {
        "port": 4400,
        "configDir": "apps/back-office/.storybook",
        "browserTarget": "back-office:build",
        "compodoc": true,
        "compodocArgs": ["-e", "json", "-d", "apps/back-office"],
        "styles": [
          "libs/shared/src/lib/style/styles.scss",
          "libs/styles/src/lib/storybook/storybook.scss",
          "libs/styles/src/lib/tailwind/tailwind.scss",
          "libs/styles/src/lib/shared/shared.scss",
          "libs/styles/src/lib/kendo/theme.scss",
          "node_modules/survey-core/survey-core.min.css"
        ],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/styles/src/lib/themes/default"]
        }
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "build-storybook": {
      "executor": "@storybook/angular:build-storybook",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/back-office",
        "configDir": "apps/back-office/.storybook",
        "browserTarget": "back-office:build",
        "compodoc": false,
        "styles": ["libs/shared/src/lib/style/styles.scss"],
        "stylePreprocessorOptions": {
          "includePaths": [
            "libs/styles/src/lib/themes/default",
            "libs/styles/src/lib/kendo"
          ]
        }
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "generate-build-version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/set-build-version.js apps/back-office/src/environments/build-version.ts"
      }
    }
  }
}
